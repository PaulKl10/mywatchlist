// https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modèle Utilisateur
model User {
  id               String    @id @default(cuid())
  tmdb_id          Int       @unique // L'ID récupéré depuis TMDB
  username         String?
  gravatar_hash    String?
  tmdb_avatar_path String?

  sessions Session[]

  // Appareils abonnés aux notifications push
  pushSubscriptions PushSubscription[]

  // Relations pour les amis
  sentFriendRequests     Friendship[] @relation("sender")
  receivedFriendRequests Friendship[] @relation("receiver")

  // Suggestions de films
  sentSuggestions     Suggestion[] @relation("suggestedBy")
  receivedSuggestions Suggestion[] @relation("suggestedTo")

  // Watchlist en BDD (pour affichage public sur profils)
  watchlistItems      WatchlistItem[]
  // Dernière resynchro complète des copies du compte TMDB (verrou ; null tant que la
  // première n'a pas réussi : import initial de la watchlist, sans activité)
  watchlist_synced_at DateTime?
  // Dernière resynchro réussie des notes (null : notes jamais importées)
  ratings_synced_at   DateTime?

  // Copie des notes TMDB (profils des amis, fil d'activité, bilan)
  ratingItems   RatingItem[]
  activities    Activity[]
  activityLikes ActivityLike[]

  // Notifications enregistrées (réponses aux suggestions), reçues et provoquées
  notifications     UserNotification[] @relation("notificationRecipient")
  sentNotifications UserNotification[] @relation("notificationActor")

  // Films comptés pour le temps de visionnage (tracking interne uniquement)
  watchTimeEntries WatchTimeEntry[]

  // « Ce soir ? »
  streaming_provider_ids   Int[]                    @default([]) // dernières plateformes choisies comme hôte
  hostedMovieNights        MovieNight[]
  movieNightParticipations MovieNightParticipant[]
}

model WatchTimeEntry {
  id            String   @id @default(cuid())
  userId        String
  tmdb_movie_id Int
  media_type    String   @default("movie") // "movie" | "tv"
  runtime       Int?
  created_at    DateTime? // première note du média ; null pour les entrées d'avant fin 2026

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, media_type, tmdb_movie_id])
}

// Cache watchlist pour affichage sur profils publics
model WatchlistItem {
  id            String   @id @default(cuid())
  userId        String
  tmdb_movie_id Int
  media_type    String   @default("movie") // "movie" | "tv"
  poster_path   String?
  title         String
  release_date  String?
  vote_average  Float?
  overview      String?
  added_at      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, media_type, tmdb_movie_id])
}

/// Copie d'une note TMDB, resynchronisée comme la watchlist.
model RatingItem {
  id           String    @id @default(cuid())
  userId       String
  tmdb_id      Int
  media_type   String // "movie" | "tv"
  rating       Float // 0.5 à 10
  title        String
  poster_path  String?
  release_date String?
  genre_ids    Int[]     @default([])
  rated_at     DateTime? // première note vue par l'app ; null si importée sans date connue

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, media_type, tmdb_id])
  @@index([userId, rated_at])
}

/// Événement du fil d'activité des amis, gardé 30 jours.
model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String // RATED | WATCHLIST_ADDED
  tmdb_id     Int
  media_type  String // "movie" | "tv"
  title       String
  poster_path String?
  rating      Float? // pour RATED
  createdAt   DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         ActivityLike[]
  notifications UserNotification[]

  // Un seul événement par titre et par type : le plus récent.
  @@unique([userId, type, media_type, tmdb_id])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// « J'aime » d'un ami sur un événement du fil, supprimé avec l'événement (30 jours).
model ActivityLike {
  id         String   @id @default(cuid())
  activityId String
  userId     String // ami qui aime
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
}

/// Notification enregistrée pour le panneau de l'en-tête, gardée 30 jours. Les demandes en
/// attente (amis, suggestions, « Ce soir ? ») n'y sont pas : elles sont lues à la source.
model UserNotification {
  id         String    @id @default(cuid())
  userId     String // destinataire
  actorId    String // ami à l'origine
  type       String // SUGGESTION_ACCEPTED | SUGGESTION_DECLINED | ACTIVITY_LIKED
  tmdb_id    Int
  media_type String // "movie" | "tv"
  title      String
  reason     String? // motif du refus (voir src/lib/suggestions/declineReasons.ts)
  activityId String? // événement aimé (ACTIVITY_LIKED), supprimé avec lui
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user     User      @relation("notificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User      @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([activityId])
}

/// Plateformes d'un titre présent dans au moins une watchlist, relevées chaque jour
/// (alerte « enfin dispo »). Aucune donnée personnelle.
model TitleAvailability {
  media_type   String // "movie" | "tv"
  tmdb_id      Int
  provider_ids Int[] // plateformes qui le proposent en abonnement en France (JustWatch via TMDB)
  checked_at   DateTime

  @@id([media_type, tmdb_id])
  @@index([checked_at])
}

model Session {
  id               String @id @default(cuid())
  tmdb_session_id  String @unique
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Table pivot pour gérer les amitiés
model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING, ACCEPTED, BLOCKED
  createdAt  DateTime @default(now())

  sender   User @relation("sender", fields: [senderId], references: [id])
  receiver User @relation("receiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

// Table pour les suggestions de films et séries
model Suggestion {
  id            String   @id @default(cuid())
  tmdb_movie_id Int      // L'ID du film/série sur TMDB
  media_type    String   @default("movie") // "movie" | "tv"
  title         String   // Pour affichage sans appel TMDB
  poster_path   String?
  fromUserId    String
  toUserId      String
  message       String?
  createdAt     DateTime @default(now())

  sender   User @relation("suggestedBy", fields: [fromUserId], references: [id])
  receiver User @relation("suggestedTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId, media_type, tmdb_movie_id])
}

model MovieNight {
  id                     String   @id @default(cuid())
  code                   String   @unique // 6 caractères
  hostId                 String? // null quand l'hôte est un invité (sans compte)
  status                 String   @default("LOBBY") // LOBBY | SWIPING | MATCH | ENDED
  provider_ids           Int[]
  genre_ids              Int[]
  deck_size              Int
  include_seen           Boolean  @default(false)
  from_watchlists        Boolean  @default(false) // films des watchlists des participants d'abord
  pending_match_movie_id Int? // film du match en attente de décision (statut MATCH)
  chosen_movie_id        Int? // film retenu (statut ENDED via « On regarde ça »)
  createdAt              DateTime @default(now())
  expiresAt              DateTime

  host         User?                   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants MovieNightParticipant[]
  rounds       MovieNightRound[]

  @@index([expiresAt])
}

model MovieNightParticipant {
  id             String   @id @default(cuid())
  movieNightId   String
  userId         String? // null pour un invité
  guestName      String? // pseudo d'invité
  guestTokenHash String?  @unique // sha256 du jeton du cookie invité
  status         String // INVITED | JOINED | DECLINED | LEFT | REMOVED
  isHost         Boolean  @default(false)
  lastSeenAt     DateTime @default(now()) // inactif au-delà de 60 s
  createdAt      DateTime @default(now())

  movieNight MovieNight       @relation(fields: [movieNightId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      MovieNightVote[]

  @@unique([movieNightId, userId])
  @@index([userId, status])
}

model MovieNightRound {
  id                        String   @id @default(cuid())
  movieNightId              String
  index                     Int // 1, 2, … (« Nouvelle pile »)
  movies                    Json // instantanés ordonnés (voir Construction de la pile)
  continued_match_movie_ids Int[]    @default([]) // matchs sur lesquels on a choisi « Continuer »
  createdAt                 DateTime @default(now())

  movieNight MovieNight       @relation(fields: [movieNightId], references: [id], onDelete: Cascade)
  votes      MovieNightVote[]

  @@unique([movieNightId, index])
}

model MovieNightVote {
  id            String   @id @default(cuid())
  roundId       String
  participantId String
  tmdb_movie_id Int
  liked         Boolean
  createdAt     DateTime @default(now())

  round       MovieNightRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant MovieNightParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId, tmdb_movie_id])
}

/// Appareil abonné aux notifications push (un `endpoint` = un navigateur).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
